---
import HexGlyph from './HexGlyph.astro';
import { getTranslations } from '../i18n/translations';

export interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const t = getTranslations(lang);

const cfpUrl = 'https://nc.linecode.cloud/dashboard/#/nc/form/29b852cd-b0d8-42aa-9de2-09b1a4d9aa0b';
---

<section id="call-for-papers" class="dark-panel py-20 md:py-28">
  <HexGlyph size={820} top="-200px" right="-380px" />
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <div class="eyebrow text-[20px] md:text-[26px]">{t.callForPapers.title}</div>
      <h2 class="headline text-[32px] md:text-[46px] mt-5">{t.callForPapers.subtitle}</h2>
      <p class="body-copy text-[16px] md:text-[19px] mt-6">{t.callForPapers.description}</p>
      <a href={cfpUrl} target="_blank" rel="noopener noreferrer" class="btn btn-teal mt-9 text-[15px] px-6 py-4">
        {t.callForPapers.submitButton}
      </a>
    </div>
  </div>
</section>
