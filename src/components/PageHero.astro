---
import Skyline from './Skyline.astro';

export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  meta?: string;
}

const { eyebrow, title, description, meta } = Astro.props;
---

<section class="relative overflow-hidden bg-white border-b border-line">
  <Skyline class="h-16 sm:h-24 md:h-32" />
  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-14 md:pt-20 pb-24 sm:pb-32 md:pb-44">
    <div class="max-w-3xl">
      <div class="eyebrow text-[17px] md:text-[22px]">{eyebrow}</div>
      <h1 class="headline text-[38px] sm:text-[48px] md:text-[60px] mt-4">{title}</h1>
      {description && <p class="body-copy text-[17px] md:text-[20px] mt-5">{description}</p>}
      {meta && <p class="note text-[14px] md:text-[15px] mt-6">{meta}</p>}
    </div>
  </div>
</section>
