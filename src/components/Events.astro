---
import UpcomingEvents from './UpcomingEvents.astro';
import PastEvents from './PastEvents.astro';
import { getPastEvents } from '../data/events';
import { getTranslations } from '../i18n/translations';

export interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const t = getTranslations(lang);
const hasPast = getPastEvents().length > 0;
---

<section id="events" class="bg-white py-20 md:py-28 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="headline text-[36px] md:text-[48px]">{t.events.title}</h2>
      <p class="body-copy text-[17px] md:text-[19px] mt-4">{t.events.subtitle}</p>
    </div>

    <div class="mt-12 md:mt-16">
      <h3 class="label text-[14px] tracking-[.04em] mb-5">{t.events.upcoming}</h3>
      <UpcomingEvents lang={lang} />
    </div>

    {hasPast && (
      <div class="mt-16 md:mt-20">
        <h3 class="label text-[14px] tracking-[.04em] mb-2">{t.events.pastEvents}</h3>
        <PastEvents lang={lang} />
      </div>
    )}
  </div>
</section>
