---
import Skyline from './Skyline.astro';
import { getTranslations } from '../i18n/translations';
import { getUpcomingEvents, getPastEvents, generateEventUrl } from '../data/events';

export interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const t = getTranslations(lang);
const pl = lang === 'pl';

const nextEvent = getUpcomingEvents()[0] ?? null;
const pastCount = getPastEvents().length;

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString(pl ? 'pl-PL' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// Polish plural for "spotkanie"
const meetingsWord = (n: number) => {
  if (!pl) return n === 1 ? 'meetup so far' : 'meetups so far';
  if (n === 1) return 'spotkanie za nami';
  const last = n % 10, tens = n % 100;
  if (last >= 2 && last <= 4 && !(tens >= 12 && tens <= 14)) return 'spotkania za nami';
  return 'spotkań za nami';
};

// Same trick as the generator: show 2^n when the number is a power of two
const exponentOf = (n: number) => {
  if (!Number.isInteger(n) || n < 2) return null;
  const e = Math.log2(n);
  return Number.isInteger(e) ? e : null;
};

const number = nextEvent ? nextEvent.meetupId : pastCount;
const exponent = exponentOf(number);

const labelText = nextEvent
  ? `${pl ? 'spotkanie WSAG' : 'WSAG meetup'}, ${formatDate(nextEvent.date)}`
  : meetingsWord(pastCount);

const headline = nextEvent
  ? (pl ? 'Widzimy się w Warszawie' : 'See you in Warsaw')
  : (pl ? 'Kolejne spotkanie już wkrótce' : 'Next meetup coming soon');

const noteText = nextEvent
  ? `${pl ? 'Następne spotkanie' : 'Next meetup'}: ${formatDate(nextEvent.date)}, ${nextEvent.time}`
  : t.events.nextEventSoon;
---

<section id="home" class="relative overflow-hidden bg-white">
  <Skyline class="h-24 sm:h-32 md:h-44" />

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-14 md:pt-20">
    <div class="text-center">
      <div class="eyebrow text-[17px] sm:text-[22px] md:text-[26px]">{t.organizationName}</div>

      <div class="mt-5 flex items-start justify-center gap-3 md:gap-5">
        <div class="num text-[150px] sm:text-[200px] md:text-[260px]" aria-label={String(number)}>{number}</div>
        {exponent !== null && (
          <div class="badge text-[24px] md:text-[38px] px-3 py-2 md:px-4 md:py-3 mt-3 md:mt-5" aria-hidden="true">2<sup>{exponent}</sup></div>
        )}
      </div>

      <div class="label text-[19px] sm:text-[22px] md:text-[28px] mt-4">{labelText}</div>

      <h1 class="headline text-[34px] sm:text-[44px] md:text-[56px] mt-8 md:mt-10 max-w-4xl mx-auto">{headline}</h1>

      <p class="body-copy text-[16px] sm:text-[18px] md:text-[21px] mt-5 max-w-3xl mx-auto">{t.hero.description}</p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        {nextEvent ? (
          <>
            <a href={generateEventUrl(nextEvent, lang)} class="btn btn-teal">{t.events.viewDetails}</a>
            <a href="#call-for-papers" class="btn">{t.callForPapers.submitButton}</a>
          </>
        ) : (
          <>
            <a href="#call-for-papers" class="btn btn-teal">{t.callForPapers.submitButton}</a>
            <a href="#events" class="btn">{t.events.pastEvents}</a>
          </>
        )}
      </div>
    </div>

    <div class="rule mt-16 md:mt-24 pt-5 pb-28 sm:pb-36 md:pb-48 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <p class="note text-[15px] md:text-[18px]">{noteText}</p>
      <div class="flex items-center gap-5">
        <img src="/images/logo-mark.png" alt="" class="h-14 md:h-16 w-auto" width="263" height="252" />
        {nextEvent?.venuePartner && (
          <>
            <div class="w-px self-stretch bg-line" aria-hidden="true"></div>
            <img src={nextEvent.venuePartner.logo} alt={nextEvent.venuePartner.name} class="h-12 md:h-14 w-auto" />
          </>
        )}
      </div>
    </div>
  </div>
</section>
