---
import HexGlyph from './HexGlyph.astro';
import { getTranslations } from '../i18n/translations';
import { getUpcomingEvents, generateEventUrl } from '../data/events';

export interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const t = getTranslations(lang);
const pl = lang === 'pl';

const nextEvent = getUpcomingEvents()[0] ?? null;

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString(pl ? 'pl-PL' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const noteText = nextEvent
  ? `${pl ? 'Następne spotkanie' : 'Next meetup'}: ${formatDate(nextEvent.date)}, ${nextEvent.time}, ${nextEvent.location.name}`
  : t.events.nextEventSoon;
---

<section id="home" class="dark-panel">
  <HexGlyph size={860} top="-300px" right="-300px" />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 md:pt-32">
    <div class="text-center">
      <div class="eyebrow text-[17px] sm:text-[22px] md:text-[26px]">{t.organizationName}</div>

      <h1 class="headline text-[34px] sm:text-[56px] md:text-[76px] mt-6 md:mt-8 max-w-5xl mx-auto">
        {pl ? 'Architektura oprogramowania.' : 'Software architecture.'}<br />
        {pl ? 'Na żywo, w Warszawie.' : 'Live, in Warsaw.'}
      </h1>

      <p class="body-copy text-[16px] sm:text-[18px] md:text-[21px] mt-6 md:mt-8 max-w-3xl mx-auto">{t.hero.description}</p>

      <div class="mt-9 md:mt-11 flex flex-wrap justify-center gap-3">
        {nextEvent ? (
          <>
            <a href={generateEventUrl(nextEvent, lang)} class="btn btn-teal text-[15px] px-6 py-4">{t.events.viewDetails}</a>
            <a href="#call-for-papers" class="btn btn-ghost-dark text-[15px] px-6 py-4">{t.callForPapers.submitButton}</a>
          </>
        ) : (
          <>
            <a href="#call-for-papers" class="btn btn-teal text-[15px] px-6 py-4">{t.callForPapers.submitButton}</a>
            <a href="#events" class="btn btn-ghost-dark text-[15px] px-6 py-4">{t.nav.events}</a>
          </>
        )}
      </div>
    </div>

    <div class="rule mt-16 md:mt-24 pt-5 pb-10 md:pb-14 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <p class="note text-[15px] md:text-[18px]">{noteText}</p>
      <div class="flex items-center gap-5">
        <img src="/images/logo-mark.png" alt="" class="h-14 md:h-16 w-auto" width="263" height="252" />
        {nextEvent?.venuePartner && (
          <>
            <div class="w-px self-stretch bg-white/20" aria-hidden="true"></div>
            <a href={nextEvent.venuePartner.url} target="_blank" rel="noopener noreferrer" class="bg-white rounded-[4px] px-3 py-2">
              <img src={nextEvent.venuePartner.logo} alt={nextEvent.venuePartner.name} class="h-10 md:h-12 w-auto" />
            </a>
          </>
        )}
      </div>
    </div>
  </div>
</section>
