---
import { getTranslations } from '../i18n/translations';

export interface Props {
  currentLang: 'pl' | 'en';
  currentPath?: string;
}

const { currentLang, currentPath = '/' } = Astro.props;
const t = getTranslations(currentLang);

const plUrl = currentLang === 'pl' ? currentPath : (currentPath.replace(/^\/en/, '') || '/');
const enUrl = currentLang === 'en' ? currentPath : `/en${currentPath === '/' ? '' : currentPath}`;
---

<div class="flex items-center gap-1.5" role="group" aria-label="Language">
  <a href={plUrl} class="chip" aria-pressed={currentLang === 'pl' ? 'true' : 'false'} title={currentLang === 'en' ? t.switchToPolish : undefined}>PL</a>
  <a href={enUrl} class="chip" aria-pressed={currentLang === 'en' ? 'true' : 'false'} title={currentLang === 'pl' ? t.switchToEnglish : undefined}>EN</a>
</div>
