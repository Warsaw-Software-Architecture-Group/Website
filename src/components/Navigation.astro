---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getTranslations } from '../i18n/translations';

export interface Props {
  lang?: 'pl' | 'en';
  isMainPage?: boolean;
}

const { lang = 'pl', isMainPage = false } = Astro.props;
const t = getTranslations(lang);
const home = lang === 'en' ? '/en' : '/';

const navItems = isMainPage
  ? [
      { href: '#about', label: t.nav.about },
      { href: '#events', label: t.nav.events },
      { href: '#call-for-papers', label: 'Call for Papers' },
      { href: '#organizers', label: t.nav.organizers },
    ]
  : [
      { href: home, label: t.nav.home },
      { href: lang === 'en' ? '/en/events' : '/events', label: t.nav.events },
      { href: `${home}#call-for-papers`, label: 'Call for Papers' },
    ];

// Path used by the language switcher to land on the same page in the other language
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-line">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-6">
      <a href={isMainPage ? '#home' : home} class="flex items-center gap-3 shrink-0">
        <img src="/images/logo-mark.png" alt="Warsaw Software Architecture Group" class="h-11 w-auto" width="263" height="252" />
      </a>

      <nav class="hidden md:flex items-center gap-7" aria-label="Main">
        {navItems.map(item => (
          <a href={item.href} class="display font-semibold text-[14px] text-ink hover:text-teal-deep transition-colors">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:block">
        <LanguageSwitcher currentLang={lang} currentPath={currentPath} />
      </div>

      <button class="md:hidden p-2 -mr-2 text-ink" id="mobile-menu-button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-white">
    <div class="px-4 py-3 flex flex-col">
      {navItems.map(item => (
        <a href={item.href} class="display font-semibold text-[15px] text-ink py-3 border-b border-line-soft last:border-0">
          {item.label}
        </a>
      ))}
      <div class="pt-4">
        <LanguageSwitcher currentLang={lang} currentPath={currentPath} />
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (this: HTMLAnchorElement, e) {
      const href = this.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
        menu?.classList.add('hidden');
        button?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
