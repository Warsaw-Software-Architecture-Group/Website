---
import { getTranslations } from '../i18n/translations';

export interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const t = getTranslations(lang);
const pl = lang === 'pl';

const facts = [
  { title: pl ? 'Warszawa' : 'Warsaw', desc: pl ? 'spotkania stacjonarne' : 'in-person meetups' },
  { title: pl ? 'Bezpłatnie' : 'Free', desc: pl ? 'otwarte dla wszystkich' : 'open to everyone' },
  { title: pl ? 'Co kilka tygodni' : 'Every few weeks', desc: pl ? 'wieczorem, po pracy' : 'in the evening, after work' },
];
---

<section id="about" class="bg-paper py-20 md:py-28 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5">
        <h2 class="headline text-[36px] md:text-[48px]">{t.about.title}</h2>
        <p class="label mt-5 text-[17px] md:text-[19px] leading-snug">{t.about.subtitle}</p>
      </div>

      <div class="md:col-span-7">
        <p class="body-copy text-[17px] md:text-[18px]">{t.about.description1}</p>
        <p class="body-copy text-[17px] md:text-[18px] mt-5">{t.about.description2}</p>

        <dl class="rule mt-10 pt-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {facts.map(f => (
            <div>
              <dt class="display font-extrabold text-[22px] text-ink" style="font-stretch:112%">{f.title}</dt>
              <dd class="text-[14px] text-muted mt-1">{f.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
