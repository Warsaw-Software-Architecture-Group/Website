---
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import Skyline from '../../../components/Skyline.astro';
import { events, getLocalizedText, toLocalDateString, type Event } from '../../../data/events';
import { getTranslations } from '../../../i18n/translations';

export async function getStaticPaths() {
  return events.map(event => ({
    params: { date: toLocalDateString(new Date(event.date)), id: event.meetupId.toString() },
    props: { event },
  }));
}

const { event } = Astro.props as { event: Event };
if (!event) {
  return Astro.redirect('/404');
}

const lang: 'pl' | 'en' = 'pl';
const t = getTranslations(lang);
const pl = lang === 'pl';
const home = pl ? '/' : '/en';
const eventsUrl = pl ? '/events' : '/en/events';

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString(pl ? 'pl-PL' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });
const shortDate = (dateString: string) => {
  const d = new Date(dateString);
  return `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
};

const getLocationName = (name: string) => (name === 'Siedziba Circle K' && !pl ? 'Circle K Headquarters' : name);

const statusText = {
  upcoming: pl ? 'Nadchodzące spotkanie' : 'Upcoming meetup',
  completed: pl ? 'Spotkanie za nami' : 'Past meetup',
  cancelled: pl ? 'Spotkanie odwołane' : 'Cancelled meetup',
}[event.status];

const hasDirections = event.location.directions && event.location.directions !== 'Details to be announced';
const hasAccessibility = event.location.accessibility && event.location.accessibility !== 'Details to be announced';

const generateGoogleCalendarUrl = (ev: Event) => {
  const toGoogle = (time: string) => {
    const d = new Date(ev.date);
    const [h, m] = time.split(':').map(Number);
    d.setHours(h, m, 0);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}T${p(d.getHours())}${p(d.getMinutes())}00`;
  };
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: ev.title,
    dates: `${toGoogle(ev.time)}/${toGoogle(ev.endTime)}`,
    details: getLocalizedText(ev.description, lang) + (ev.registrationUrl ? `\n\n${pl ? 'Rejestracja' : 'Registration'}: ${ev.registrationUrl}` : ''),
    location: `${ev.location.name}, ${ev.location.address}, ${ev.location.city}`,
    ctz: 'Europe/Warsaw',
  });
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
};
const googleCalendarUrl = generateGoogleCalendarUrl(event);

const resourceLabel: Record<string, string> = {
  recording: t.eventDetails.recording,
  slides: t.eventDetails.slides,
  template: t.eventDetails.template,
  book: t.eventDetails.book,
  code: t.eventDetails.code,
  blog: t.eventDetails.blog,
};

const countdownUnits = pl
  ? [['days', 'dni'], ['hours', 'godzin'], ['minutes', 'minut'], ['seconds', 'sekund']]
  : [['days', 'days'], ['hours', 'hours'], ['minutes', 'minutes'], ['seconds', 'seconds']];
---

<Layout title={`${event.title} - WSAG`} description={getLocalizedText(event.description, lang)} type="article" lang={lang}>
  <Navigation lang={lang} isMainPage={false} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": event.title,
    "description": getLocalizedText(event.description, lang),
    "startDate": `${event.date}T${event.time}`,
    "endDate": `${event.date}T${event.endTime || '21:00'}`,
    "eventStatus": event.status === 'cancelled' ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": event.location.name,
      "address": { "@type": "PostalAddress", "streetAddress": event.location.address, "addressLocality": "Warsaw", "addressCountry": "PL" }
    },
    "organizer": { "@type": "Organization", "name": "Warsaw Software Architecture Group", "url": Astro.site || "https://wsag.org.pl" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "PLN", "availability": "https://schema.org/InStock", "url": event.registrationUrl },
    "performer": event.presentations.map(p => {
      const s = event.speakers.find(sp => sp.id === p.speakerId);
      return s ? { "@type": "Person", "name": s.name, "jobTitle": s.role, "worksFor": { "@type": "Organization", "name": s.company } } : null;
    }).filter(Boolean)
  })} />

  <main>
    <!-- Poster-style header -->
    <section class="relative overflow-hidden bg-white border-b border-line">
      <Skyline class="h-20 sm:h-28 md:h-40" />
      <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-12 md:pt-16">
        <div class="text-center">
          <div class="eyebrow text-[17px] sm:text-[20px] md:text-[24px]">{statusText}</div>

          <div class="mt-4 flex items-start justify-center gap-3 md:gap-5">
            <div class="num text-[130px] sm:text-[180px] md:text-[220px]" aria-hidden="true">{event.meetupId}</div>
            <div class="badge text-[18px] sm:text-[24px] md:text-[30px] px-3 py-2 md:px-4 md:py-3 mt-2 md:mt-4">{shortDate(event.date)}</div>
          </div>

          <div class="label text-[17px] sm:text-[20px] md:text-[24px] mt-3">
            {formatDate(event.date)}, {event.time}–{event.endTime}
          </div>

          <h1 class="headline text-[32px] sm:text-[40px] md:text-[50px] mt-7">{event.title}</h1>
          <p class="body-copy text-[16px] md:text-[19px] mt-4 max-w-3xl mx-auto">{getLocalizedText(event.description, lang)}</p>

          {event.status === 'upcoming' && (
            <div class="mt-9">
              <div id="countdown" class="flex justify-center gap-2 sm:gap-3">
                {countdownUnits.map(([key, label]) => (
                  <div class="card min-w-[70px] sm:min-w-[88px] px-3 py-3">
                    <div id={`countdown-${key}`} class="display font-black text-[28px] sm:text-[34px] leading-none text-ink" style="font-stretch:112%">--</div>
                    <div class="text-[12px] text-muted mt-1.5">{label}</div>
                  </div>
                ))}
              </div>
              <div class="mt-7 flex flex-wrap justify-center gap-3">
                {event.registrationUrl && (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-teal text-[15px] px-6 py-4">
                    {pl ? 'Zarejestruj się' : 'Register'}
                  </a>
                )}
                <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" class="btn text-[15px] px-6 py-4">
                  {pl ? 'Dodaj do kalendarza' : 'Add to calendar'}
                </a>
              </div>
            </div>
          )}
        </div>

        <div class="rule mt-14 md:mt-20 pt-5 pb-24 sm:pb-32 md:pb-44 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <p class="note text-[15px] md:text-[18px]">
            {getLocationName(event.location.name)}{event.location.address ? `, ${event.location.address}` : ''}
          </p>
          <div class="flex items-center gap-5">
            <img src="/images/logo-mark.png" alt="" class="h-14 md:h-16 w-auto" width="263" height="252" />
            {event.venuePartner && (
              <>
                <div class="w-px self-stretch bg-line" aria-hidden="true"></div>
                <a href={event.venuePartner.url} target="_blank" rel="noopener noreferrer">
                  <img src={event.venuePartner.logo} alt={event.venuePartner.name} class="h-12 md:h-14 w-auto" />
                </a>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Main column -->
        <div class="lg:col-span-8 space-y-14 md:space-y-16">
          <section>
            <h2 class="headline text-[28px] md:text-[34px]">{t.eventDetails.aboutThisEvent}</h2>
            <div class="mt-5 space-y-4">
              {getLocalizedText(event.longDescription, lang).split('\n\n').map(p => (
                <p class="text-[16px] md:text-[17px] text-slate-text leading-relaxed">{p}</p>
              ))}
            </div>
          </section>

          {event.agenda && event.agenda.length > 0 && (
            <section>
              <h2 class="headline text-[28px] md:text-[34px]">Agenda</h2>
              <ol class="mt-6 border-t border-line">
                {event.agenda.map(item => {
                  const isTalk = item.type === 'presentation' || item.type === 'talk';
                  const presentation = isTalk && item.presentationId ? event.presentations.find(p => p.id === item.presentationId) : null;
                  const speaker = isTalk && item.speakerIds?.[0] ? event.speakers.find(s => s.id === item.speakerIds![0]) : null;
                  const cancelled = !!presentation?.cancelled;
                  const title = presentation ? getLocalizedText(presentation.title, lang) : item.title;
                  return (
                    <li class="grid grid-cols-[64px_1fr] sm:grid-cols-[88px_1fr] gap-4 sm:gap-6 py-6 border-b border-line">
                      <div class="display font-bold text-[15px] sm:text-[17px] text-teal-deep pt-0.5" style="font-stretch:110%">{item.time}</div>

                      {isTalk ? (
                        <div class={cancelled ? 'opacity-70' : ''}>
                          <div class="flex items-start gap-4">
                            {speaker?.photo && (
                              <img src={speaker.photo} alt={speaker.name} class={`h-14 w-14 shrink-0 rounded-[4px] object-cover ${cancelled ? 'grayscale' : ''}`} loading="lazy" />
                            )}
                            <div class="min-w-0">
                              <h3 class={`display font-extrabold text-[18px] md:text-[21px] leading-tight ${cancelled ? 'line-through text-muted' : 'text-ink'}`} style="font-stretch:112%">{title}</h3>
                              {speaker && (
                                <p class="text-[14px] text-slate-text mt-1">
                                  {speaker.name}{speaker.role ? `, ${speaker.role}` : ''}{speaker.company ? ` (${speaker.company})` : ''}
                                </p>
                              )}
                              <div class="mt-2.5 flex flex-wrap gap-1.5">
                                {cancelled ? (
                                  <span class="tag !border-ink !text-ink">{pl ? 'odwołana' : 'cancelled'}</span>
                                ) : (
                                  <>
                                    {presentation?.language && <span class="tag">{presentation.language === 'pl' ? (pl ? 'po polsku' : 'in Polish') : (pl ? 'po angielsku' : 'in English')}</span>}
                                    {presentation?.duration && <span class="tag">{presentation.duration} min</span>}
                                  </>
                                )}
                              </div>
                              {cancelled && presentation?.cancellationNote && (
                                <p class="text-[13px] text-muted mt-2">{getLocalizedText(presentation.cancellationNote, lang)}</p>
                              )}
                            </div>
                          </div>

                          {presentation?.description && !cancelled && (
                            <div class="rich text-[15px] text-slate-text leading-relaxed mt-4" set:html={getLocalizedText(presentation.description, lang)} />
                          )}

                          {event.status === 'completed' && presentation?.resources && presentation.resources.length > 0 && (
                            <div class="mt-4">
                              <div class="label text-[12px] tracking-[.04em] mb-2">{t.eventDetails.materials}</div>
                              <div class="flex flex-wrap gap-2">
                                {presentation.resources.map(r => {
                                  const rt = typeof r.title === 'string' ? r.title : (r.title[lang] || r.title.pl);
                                  const internal = r.url.startsWith('/');
                                  return (
                                    <a href={r.url} target={internal ? '_self' : '_blank'} rel={internal ? undefined : 'noopener noreferrer'} class="chip inline-flex items-center gap-1.5">
                                      {r.type === 'recording' && (
                                        <svg class="w-3.5 h-3.5 text-teal-deep" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                                      )}
                                      <span>{resourceLabel[r.type] ? `${resourceLabel[r.type]}: ` : ''}{rt}</span>
                                    </a>
                                  );
                                })}
                              </div>
                            </div>
                          )}
                        </div>
                      ) : (
                        <div>
                          <h3 class="display font-semibold text-[16px] text-muted">{item.title}</h3>
                          {item.description && <p class="text-[13px] text-muted mt-0.5">{item.description}</p>}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ol>
            </section>
          )}

          {event.privacyNotice && (
            <section class="card p-6 md:p-7 border-l-4 !border-l-teal">
              <h2 class="display font-extrabold text-[18px] text-ink" style="font-stretch:112%">{pl ? 'Informacja o prywatności' : 'Privacy notice'}</h2>
              <p class="text-[15px] text-slate-text leading-relaxed mt-2">{getLocalizedText(event.privacyNotice, lang)}</p>
            </section>
          )}

          <section>
            <h2 class="headline text-[28px] md:text-[34px]">{t.eventDetails.location}</h2>
            <div class="card mt-5 overflow-hidden">
              <div id="event-map" class="h-72 md:h-80 w-full bg-paper"></div>
            </div>
          </section>
        </div>

        <!-- Side column -->
        <aside class="lg:col-span-4">
          <div class="card p-6 lg:sticky lg:top-24">
            <h2 class="label text-[13px] tracking-[.04em]">{t.eventDetails.eventDetailsTitle}</h2>
            <dl class="mt-4 space-y-5">
              <div>
                <dt class="display font-bold text-[14px] text-ink">{t.eventDetails.location}</dt>
                <dd class="text-[14px] text-slate-text mt-1">
                  {getLocationName(event.location.name)}<br />
                  {event.location.address}<br />
                  {event.location.zipCode ? `${event.location.zipCode} ` : ''}{event.location.city}
                  {hasDirections && <><br /><span class="text-ink font-medium">{event.location.directions}</span></>}
                </dd>
              </div>
              <div>
                <dt class="display font-bold text-[14px] text-ink">{pl ? 'Termin' : 'When'}</dt>
                <dd class="text-[14px] text-slate-text mt-1">{formatDate(event.date)}<br />{event.time}–{event.endTime}</dd>
              </div>
              {hasAccessibility && (
                <div>
                  <dt class="display font-bold text-[14px] text-ink">{t.eventDetails.accessibility}</dt>
                  <dd class="text-[14px] text-slate-text mt-1">{event.location.accessibility}</dd>
                </div>
              )}
              <div>
                <dt class="display font-bold text-[14px] text-ink">{t.eventDetails.capacity}</dt>
                <dd class="text-[14px] text-slate-text mt-1">{t.eventDetails.upToAttendees.replace('{count}', String(event.maxAttendees))}</dd>
              </div>
              {event.venuePartner && (
                <div>
                  <dt class="display font-bold text-[14px] text-ink">{pl ? 'Gospodarz' : 'Host'}</dt>
                  <dd class="mt-2">
                    <a href={event.venuePartner.url} target="_blank" rel="noopener noreferrer" class="inline-block card p-3 hover:border-ink transition-colors">
                      <img src={event.venuePartner.logo} alt={event.venuePartner.name} class="h-10 w-auto" />
                    </a>
                  </dd>
                </div>
              )}
            </dl>

            {event.status === 'upcoming' && event.registrationUrl && (
              <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-teal w-full justify-center mt-6">
                {pl ? 'Zarejestruj się' : 'Register'}
              </a>
            )}

            <div class="rule mt-6 pt-5 flex flex-col gap-2">
              <a href={eventsUrl} class="display font-semibold text-[14px] text-teal-deep hover:underline">{pl ? 'Wszystkie wydarzenia' : 'All events'}</a>
              <a href={home} class="display font-semibold text-[14px] text-ink hover:underline">{pl ? 'Strona główna' : 'Home'}</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline define:vars={{ eventLocation: event.location }}>
  document.addEventListener('DOMContentLoaded', function () {
    const tiles = () => L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    });
    const fallback = () => tiles().addTo(L.map('event-map').setView([52.2297, 21.0122], 13));
    const address = `${eventLocation.address}, ${eventLocation.city}`;

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`)
      .then(r => r.json())
      .then(data => {
        if (!data || data.length === 0) return fallback();
        const lat = parseFloat(data[0].lat), lon = parseFloat(data[0].lon);
        const map = L.map('event-map').setView([lat, lon], 16);
        tiles().addTo(map);
        L.marker([lat, lon]).addTo(map)
          .bindPopup(`<strong>${eventLocation.name}</strong><br/>${eventLocation.address}<br/>${eventLocation.city}`)
          .openPopup();
      })
      .catch(fallback);
  });
</script>

<script is:inline define:vars={{ eventDate: event.date, eventTime: event.time, nowText: pl ? 'Spotkanie już trwa' : 'Happening now' }}>
  document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('countdown');
    if (!el) return;
    const target = new Date(eventDate);
    const [h, m] = eventTime.split(':').map(Number);
    target.setHours(h, m, 0, 0);

    const pad = n => String(n).padStart(2, '0');
    function tick() {
      const diff = target - new Date();
      if (diff <= 0) {
        el.innerHTML = `<div class="badge text-[20px] px-4 py-3">${nowText}</div>`;
        clearInterval(timer);
        return;
      }
      document.getElementById('countdown-days').textContent = pad(Math.floor(diff / 86400000));
      document.getElementById('countdown-hours').textContent = pad(Math.floor((diff % 86400000) / 3600000));
      document.getElementById('countdown-minutes').textContent = pad(Math.floor((diff % 3600000) / 60000));
      document.getElementById('countdown-seconds').textContent = pad(Math.floor((diff % 60000) / 1000));
    }
    tick();
    const timer = setInterval(tick, 1000);
  });
</script>
