---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getTranslations } from '../../i18n/translations';

const lang: 'pl' | 'en' = 'en';
const t = getTranslations(lang);
const pl = lang === 'pl';
const lastUpdated = pl ? '4 października 2025' : 'October 4, 2025';
const s = t.privacy.sections;
---

<Layout
  title={`${t.privacy.title} - WSAG`}
  description={pl
    ? 'Polityka prywatności Warsaw Software Architecture Group. Dowiedz się, jak chronimy Twoje dane osobowe i szanujemy Twoją prywatność.'
    : "Warsaw Software Architecture Group's privacy policy. Learn how we protect your personal data and respect your privacy."}
  lang={lang}
>
  <Navigation lang={lang} isMainPage={false} />
  <main>
    <PageHero
      eyebrow={pl ? 'Ochrona danych' : 'Data protection'}
      title={t.privacy.title}
      description={t.privacy.subtitle}
      meta={`${t.privacy.lastUpdated}: ${lastUpdated}`}
    />

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="doc max-w-3xl">
        <section>
          <h2>{s.dataCollection.title}</h2>
          <p>{s.dataCollection.content}</p>
        </section>

        <section>
          <h2>{s.dataUse.title}</h2>
          <p>{s.dataUse.content}</p>
          <ul>{s.dataUse.items.map(item => <li>{item}</li>)}</ul>
        </section>

        <section>
          <h2>{s.dataSharing.title}</h2>
          <p>{s.dataSharing.content}</p>
        </section>

        <section>
          <h2>{s.dataProtection.title}</h2>
          <p>{s.dataProtection.content}</p>
        </section>

        <section>
          <h2>{s.cookies.title}</h2>
          <p>{s.cookies.content}</p>
        </section>

        <section>
          <h2>{s.rights.title}</h2>
          <p>{s.rights.content}</p>
          <ul>{s.rights.items.map(item => <li>{item}</li>)}</ul>
        </section>

        <section>
          <h2>{s.contact.title}</h2>
          <p>{s.contact.content}</p>
          <div class="card p-5 mt-4 flex flex-col gap-1">
            <a href="mailto:kamil@wsag.org.pl" class="display font-bold text-[15px] text-ink hover:text-teal-deep">kamil@wsag.org.pl</a>
            <a href="mailto:tomasz@wsag.org.pl" class="display font-bold text-[15px] text-ink hover:text-teal-deep">tomasz@wsag.org.pl</a>
          </div>
        </section>

        <section>
          <h2>{s.changes.title}</h2>
          <p>{s.changes.content}</p>
        </section>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
