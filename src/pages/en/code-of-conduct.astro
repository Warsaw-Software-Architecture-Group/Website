---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getTranslations } from '../../i18n/translations';

const lang: 'pl' | 'en' = 'en';
const t = getTranslations(lang);
const pl = lang === 'pl';
const c = t.codeOfConduct;
---

<Layout
  title={`${c.title} - WSAG`}
  description={pl
    ? 'Kodeks postępowania Warsaw Software Architecture Group: otwarte, przyjazne i wolne od nękania środowisko dla wszystkich członków społeczności.'
    : "Warsaw Software Architecture Group's code of conduct ensures a welcoming, inclusive, and harassment-free environment for all community members."}
  lang={lang}
>
  <Navigation lang={lang} isMainPage={false} />
  <main>
    <PageHero
      eyebrow={pl ? 'Zasady społeczności' : 'Community guidelines'}
      title={c.title}
      description={c.subtitle}
    />

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="doc max-w-3xl">
        <section>
          <h2>{c.ourCommitment}</h2>
          <p>{c.ourCommitmentText}</p>
        </section>

        <section>
          <h2>{c.ourStandards}</h2>
          <p>{c.ourStandardsText}</p>
          <ul>{c.standardsList.map(item => <li>{item}</li>)}</ul>
          <p class="!mt-6">{c.unacceptableBehavior}</p>
          <ul>{c.unacceptableList.map(item => <li class="neg">{item}</li>)}</ul>
        </section>

        <section>
          <h2>{c.scope}</h2>
          <p>{c.scopeText}</p>
        </section>

        <section>
          <h2>{c.enforcement}</h2>
          <p>{c.enforcementText}</p>
        </section>

        <section>
          <h2>{c.reportingTitle}</h2>
          <p>{c.reportingText}</p>

          <div class="grid sm:grid-cols-2 gap-4 mt-5">
            <div class="card p-5">
              <div class="label text-[12px] tracking-[.04em]">{c.email}</div>
              <div class="mt-2 flex flex-col gap-1">
                <a href="mailto:kamil@wsag.org.pl" class="display font-bold text-[15px] text-ink hover:text-teal-deep">kamil@wsag.org.pl</a>
                <a href="mailto:tomasz@wsag.org.pl" class="display font-bold text-[15px] text-ink hover:text-teal-deep">tomasz@wsag.org.pl</a>
              </div>
            </div>
            <div class="card p-5">
              <div class="label text-[12px] tracking-[.04em]">{c.inPerson}</div>
              <p class="!mb-0 mt-2 text-[14px]">
                {pl ? 'Podejdź do dowolnej osoby z zespołu organizacyjnego podczas wydarzenia.' : 'Approach any member of the organizing team during the event.'}
              </p>
            </div>
          </div>

          <div class="card p-5 mt-4 border-l-4 !border-l-teal">
            <div class="display font-extrabold text-[16px] text-ink" style="font-stretch:112%">{c.confidentialityTitle}</div>
            <p class="!mb-0 mt-1 text-[14px]">{c.confidentiality}</p>
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
