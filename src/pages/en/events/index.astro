---
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import UpcomingEvents from '../../../components/UpcomingEvents.astro';
import PastEvents from '../../../components/PastEvents.astro';
import { getPastEvents } from '../../../data/events';
import { getTranslations } from '../../../i18n/translations';

const lang: 'pl' | 'en' = 'en';
const t = getTranslations(lang);
const home = lang === 'en' ? '/en' : '/';
const hasPast = getPastEvents().length > 0;
---

<Layout title={`${t.events.allEvents} - WSAG`} description={t.events.allEventsSubtitle} lang={lang}>
  <Navigation lang={lang} isMainPage={false} />
  <main>
    <PageHero eyebrow={t.organizationName} title={t.events.allEvents} description={t.events.allEventsSubtitle} />

    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="label text-[14px] tracking-[.04em] mb-5">{t.events.upcoming}</h2>
        <UpcomingEvents lang={lang} />

        {hasPast && (
          <div class="mt-16 md:mt-20">
            <h2 class="label text-[14px] tracking-[.04em] mb-2">{t.events.pastEvents}</h2>
            <PastEvents lang={lang} />
          </div>
        )}
      </div>
    </section>

    <section class="dark-panel py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="max-w-2xl">
          <h2 class="headline text-[30px] md:text-[40px]">{t.events.speakAtWSAG}</h2>
          <p class="body-copy text-[16px] md:text-[18px] mt-4">{t.events.speakAtWSAGDesc}</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a href={`${home}#call-for-papers`} class="btn btn-teal">{t.events.becomeASpeaker}</a>
          <a href={home} class="btn btn-ghost-dark">{t.events.backToHome}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
